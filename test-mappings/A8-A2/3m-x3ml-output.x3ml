   <mappings>
      <mapping>
         <domain>
            <source_node>/scheda/row</source_node>
            <target_node>
               <entity>
                  <type>crmarchaeo:A8_Stratigraphic_Unit</type>
                  <type>crmarchaeo:A2_Stratigraphic_Volume_Unit</type>
                  <instance_generator name="URIwithTypeAndId">
                     <arg name="type" type="constant">stratigraphic-unit</arg>
                     <arg name="id" type="xpath">US_ID/text()</arg>
                  </instance_generator>
                  <label_generator name="Literal">
                     <arg name="text" type="xpath">US_ID/text()</arg>
                  </label_generator>
                  <additional>
                     <relationship>crm:P2_has_type</relationship>
                     <entity>
                        <type>crm:E55_Type</type>
                        <instance_generator name="UriwithTye">
                           <arg name="type" type="constant">stratigraphic-unit</arg>
                        </instance_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>crm:P1_is_identified_by</relationship>
                     <entity>
                        <type>crm:E42_Identifier</type>
                        <instance_generator name="UriwithTye">
                           <arg name="type" type="constant">us-number</arg>
                        </instance_generator>
                     </entity>
                  </additional>
               </entity>
            </target_node>
         </domain>
