<?xml version="1.0" encoding="UTF-8"?>
<x3ml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      source_type="xpath"
      version="1.0"
      xsi:noNamespaceSchemaLocation="https://isl.ics.forth.gr/x3ml/schema/x3ml.xsd">
   <info>
      <title>Lynx_places_sites</title>
      <general_description/>
      <source>
         <source_info>
            <source_schema schema_file="places_and_sites.xml" type="xml" version="">places_and_sites</source_schema>
            <namespaces>
               <namespace prefix="" uri=""/>
            </namespaces>
         </source_info>
      </source>
      <target>
         <target_info>
            <target_schema schema_file="CRMgeo_v1.2.rdfs" type="rdfs" version="">CRMgeo_v1.2</target_schema>
            <namespaces>
               <namespace prefix="geo" uri="http://www.ics.forth.gr/isl/CRMgeo/"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="lynx" uri="http://www.lynx.com/resource/"/>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
            </namespaces>
         </target_info>
      </target>
      <mapping_info>
         <mapping_created_by_org/>
         <mapping_created_by_person/>
         <in_collaboration_with/>
      </mapping_info>
      <example_data_info>
         <example_data_from/>
         <example_data_contact_person/>
         <example_data_source_record/>
         <generator_policy_info/>
         <example_data_target_record/>
         <thesaurus_info/>
      </example_data_info>
   </info>
   <namespaces>
      <namespace prefix="lynx" uri="http://www.lynx.com/resource/"/>
   </namespaces>
   <mappings>
      <mapping>
         <domain>
            <source_node>/places/place</source_node>
            <target_node>
               <entity>
                  <type>crm:E53_Place</type>
                  <instance_generator name="lynx_place">
                     <arg name="place_id" type="xpath">place_id/text()</arg>
                  </instance_generator>
                  <additional>
                     <relationship>crm:P2_has_type</relationship>
                     <entity>
                        <type>crm:E55_Type</type>
                        <instance_generator name="UriWithType">
                           <arg name="type" type="constant">place</arg>
                        </instance_generator>
                     </entity>
                  </additional>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>place_name</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P1_is_identified_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>place_name</source_node>
               <target_node>
                  <entity>
                     <type>crm:E41_Appellation</type>
                     <instance_generator name="lynx_place_name">
                        <arg name="place_id" type="xpath">../place_id/text()</arg>
                        <arg name="place_name" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="prefLabel">
                        <arg name="text" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>coordinates</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P168_place_is_defined_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>coordinates</source_node>
               <target_node>
                  <entity>
                     <type>rdfs:Literal</type>
                     <instance_generator name="coordinates">
                        <arg name="coordinates" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="Literal">
                        <arg name="text" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>site_id</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P89_falls_within</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>site_id</source_node>
               <target_node>
                  <entity>
                     <type>crm:E53_Place</type>
                     <instance_generator name="lynx_site">
                        <arg name="site_id" type="xpath">text()</arg>
                     </instance_generator>
                     <additional>
                        <relationship>crm:P1_is_identified_by</relationship>
                        <entity>
                           <type>crm:E41_Appellation</type>
                           <instance_generator name="lynx_site_name">
                              <arg name="place_id" type="xpath">../place_id/text()</arg>
                              <arg name="site_id" type="xpath">../site_id/text()</arg>
                              <arg name="site_name" type="xpath">../site_name/text()</arg>
                           </instance_generator>
                           <label_generator name="Literal">
                              <arg name="text" type="xpath">../site_name/text()</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>crm:P168_place_is_defined_by</relationship>
                        <entity>
                           <type>rdfs:Literal</type>
                           <instance_generator name="coordinates">
                              <arg name="coordinates" type="xpath">../site_coordinates/text()</arg>
                           </instance_generator>
                           <label_generator name="Literal">
                              <arg name="text" type="xpath">../site_coordinates/text()</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="UriWithType">
                              <arg name="type" type="constant">site</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
      </mapping>
   </mappings>
</x3ml>
