<?xml version="1.0" encoding="UTF-8"?>
<x3ml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      source_type="xpath"
      version="1.0"
      xsi:noNamespaceSchemaLocation="https://isl.ics.forth.gr/x3ml/schema/x3ml.xsd">
   <info>
      <title>Person</title>
      <general_description/>
      <source>
         <source_info>
            <source_schema schema_file="Person_sample.xml" type="xml" version="">Person_sample</source_schema>
            <namespaces>
               <namespace prefix="" uri=""/>
            </namespaces>
         </source_info>
      </source>
      <target>
         <target_info>
            <target_schema schema_file="CRMgeo_v1.2.rdfs" type="rdfs" version="">CRMgeo_v1.2</target_schema>
            <namespaces>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="geo" uri="http://www.ics.forth.gr/isl/CRMgeo/"/>
            </namespaces>
         </target_info>
         <target_info>
            <target_schema schema_file="CIDOC_CRM_v7.1.3.rdf" type="rdf" version="">CIDOC_CRM_v7.1.3</target_schema>
            <namespaces>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
               <namespace prefix="lynx" uri="http://www.lynx.com/resource/"/>
            </namespaces>
         </target_info>
      </target>
      <mapping_info>
         <mapping_created_by_org/>
         <mapping_created_by_person/>
         <in_collaboration_with/>
      </mapping_info>
      <example_data_info>
         <example_data_from/>
         <example_data_contact_person/>
         <example_data_source_record/>
         <generator_policy_info/>
         <example_data_target_record/>
         <thesaurus_info/>
      </example_data_info>
   </info>
   <namespaces>
      <namespace prefix="lynx" uri="http://www.lynx.com/resource/"/>
   </namespaces>
   <mappings>
      <mapping>
         <domain>
            <source_node>/scheda/row</source_node>
            <target_node>
               <entity>
                  <type>crm:E21_Person</type>
                  <instance_generator name="URIwithTypeAndId">
                     <arg name="type" type="constant">person</arg>
                     <arg name="id" type="xpath">Unique_ID/text()</arg>
                  </instance_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>Unique_ID</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P1_is_identified_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>Unique_ID</source_node>
               <target_node>
                  <entity>
                     <type>crm:E42_Identifier</type>
                     <instance_generator name="person-unique-identifier">
                        <arg name="Unique_ID" type="xpath">text()</arg>
                     </instance_generator>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="URIwithType">
                              <arg name="type" type="constant">unique-id</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>Name_Surname</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P1_is_identified_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>Name_Surname</source_node>
               <target_node>
                  <entity>
                     <type>crm:E41_Appellation</type>
                     <instance_generator name="personAppellation">
                        <arg name="id" type="xpath">../Unique_ID/text()</arg>
                        <arg name="name" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="prefLabel">
                        <arg name="text" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>Birth_place</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P98i_was_born</relationship>
                  <entity>
                     <type>crm:E67_Birth</type>
                     <instance_generator name="birth-event">
                        <arg name="uniqueid" type="xpath">../Unique_ID/text()</arg>
                     </instance_generator>
                     <additional>
                        <relationship>crm:P4_has_time-span</relationship>
                        <entity>
                           <type>crm:E52_Time-Span</type>
                           <instance_generator name="person-birth-date">
                              <arg name="id" type="xpath">../Unique_ID/text()</arg>
                              <arg name="birthdate" type="xpath">../Birth_date/text()</arg>
                           </instance_generator>
                           <label_generator name="Literal">
                              <arg name="text" type="xpath">../Birth_date/text()</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>crm:P7_took_place_at</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>Birth_place</source_node>
               <target_node>
                  <entity>
                     <type>crm:E53_Place</type>
                     <instance_generator name="lynx-place">
                        <arg name="id" type="xpath">text()</arg>
                     </instance_generator>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="URIwithType">
                              <arg name="type" type="constant">birth-place</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>Death_place</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P100i_died_in</relationship>
                  <entity>
                     <type>crm:E69_Death</type>
                     <instance_generator name="death-event">
                        <arg name="uniqueid" type="xpath">../Unique_ID/text()</arg>
                     </instance_generator>
                     <additional>
                        <relationship>crm:P4_has_time-span</relationship>
                        <entity>
                           <type>crm:E52_Time-Span</type>
                           <instance_generator name="person-death-date">
                              <arg name="id" type="xpath">../Unique_ID/text()</arg>
                              <arg name="deathdate" type="xpath">text()</arg>
                           </instance_generator>
                           <label_generator name="Literal">
                              <arg name="text" type="xpath">../Death_date/text()</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>crm:P7_took_place_at</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>Death_place</source_node>
               <target_node>
                  <entity>
                     <type>crm:E53_Place</type>
                     <instance_generator name="lynx-place">
                        <arg name="id" type="xpath">text()</arg>
                     </instance_generator>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="URIwithType">
                              <arg name="type" type="constant">death-place</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>Biography</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P67i_is_referred_to_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>Biography</source_node>
               <target_node>
                  <entity>
                     <type>crm:E73_Information_Object</type>
                     <instance_generator name="UUID"/>
                     <label_generator name="Literal">
                        <arg name="text" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>Role</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P2_has_type</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>Role</source_node>
               <target_node>
                  <entity>
                     <type>crm:E55_Type</type>
                     <instance_generator name="UUID"/>
                  </entity>
               </target_node>
            </range>
         </link>
      </mapping>
   </mappings>
</x3ml>
